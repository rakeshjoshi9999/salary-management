# Copy to .env (which is gitignored) and fill in. `npm run dev` and `npm run seed:users` read it.
MONGODB_URI=mongodb://localhost:27017/salary
PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:5173

# At least 32 characters and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Seconds. Defaults: 900 (15 minutes) and 604800 (7 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Only for `npm run seed:users`: the first HR manager (password: 8 to 72 bytes).
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
